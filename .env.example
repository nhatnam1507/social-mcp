# Local development app identity for `make run`.
# Copy this file to .env (git-ignored) and fill in the platforms you develop against. Leave a
# platform's lines empty to keep it unavailable. Each platform needs all of its required values.
# Release builds get the same values from GitHub Actions secrets instead (docs/maintainer-oauth-apps.md).

# Google Cloud OAuth client of type "Desktop app" with YouTube Data API v3 enabled.
SOCIAL_MCP_YOUTUBE_CLIENT_ID=
SOCIAL_MCP_YOUTUBE_CLIENT_SECRET=

# TikTok developer app with Login Kit (Desktop) and the Content Posting API.
SOCIAL_MCP_TIKTOK_CLIENT_KEY=
SOCIAL_MCP_TIKTOK_CLIENT_SECRET=

# Meta Business app with Facebook Login for Business. APP_MODE is optional: development (default) or live.
SOCIAL_MCP_META_APP_ID=
SOCIAL_MCP_META_APP_SECRET=
SOCIAL_MCP_META_LOGIN_CONFIG_ID=
SOCIAL_MCP_META_APP_MODE=

# Optional, development only: move the dev daemon off port 8765 so it can run next to your real one.
# Google and TikTok accept any loopback port; Meta sign-in only works on 8765.
# SOCIAL_MCP_LISTEN_PORT=18765
